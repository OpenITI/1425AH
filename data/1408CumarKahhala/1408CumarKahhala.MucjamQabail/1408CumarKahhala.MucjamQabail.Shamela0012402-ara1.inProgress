### $ حسن ms1095 (البو) :
# </span></span></span></span></span></span></span></span></span></span>
# فرع من آل زور من خفاجة في الحلة بالعراق.
# العزاوي 4/ 89
# حسن (البو) :
# فخذ من الشرابيين بالعراق.
# العزاوي 3/ 97
# حسن (البو) :
# فرع من بودريس من البو محمد النمر من البو نمر من البو سالم بالعراق.
# العزاوي 3/ 113
# حسن (البو) :
# فخذ من الكرطان بالعراق. يسكن في اليوسفية.
# العزاوي 3/ 137
### $ حسن:
# قسم من راشد من طيء بسورية.
# (خ) مذكراتي.
# حسن (البو) :
# فرع من البو حمود من الجعافرة من العنبكية (العنبقية) بالعراق.
# العزاوي 4/ 223
# حسن (البو) :
# فخذ من الكرابلة بالعراق.
# العزاوي 3/ 119
# حسن (البو) :
# فرع من بو عفارة من الحلابسة بالعراق.
# العزاوي 3/ 117
# حسن (البو) :
# فرع من البو مهلهل من الجنابيين بالعراق.
# العزاوي 3/ 103
# حسن (البو) :
# فرع من الثلث من العكيدات (العقيدات) بالعراق.
# العزاوي 3/ 132
# حسن (بو) :
# قسم من الثلث من البو جامل (كامل) من العقيدات، مراكزه الرئيسية: سويدان
~~الشامية، والجزيرة، ومناطق تجوله: منطقة الميادين، بمحافظة دير الزور
~~بسورية.
# (خ) مذكراتي.
# حسن (البو) :
# فرع من البو بكر من العزة بالعراق.
# العزاوي 3/ 176
# PageV04P108
### $ 
### $ 
### $ 
### $ 
### $ 
### $ حسن (البو) :
# </span></span></span></span></span>
# فرع من المجاوير من الأكرع بالعراق.
# العزاوي 3/ 208
# حسن (البو) :
# فخذ من البو فراج من العزة بالعراق، وأصله من البو شهاب. يقطن بعضه في
~~عزيز سامراء وحويزات، فروعه: البو حميد، البو عبد، نفس البو حسن، والبو
~~رباح.
# العزاوي 3/ 182
# حسن (البو) :
# فرقة من البو ليل، عدد بيوتها، 40، مراكزها الرئيسية:
# منطقة أبو الظهور، وقرى محافظة ادلب بسورية، ومناطق تجولها: المنطقة
~~الواقعة بين الحمراء وجبل بلعاس.
# (خ) مذكراتي.
# حسن (البو) :
# فخذ من البو ظاهر من عشيرة المشاهدة بالعراق، من فروعه: البو ياسين، بو
~~عطو الحسن، بو سهيل الحسن، بو ناصر، بو ممدود الحسن، وبو عبد الله الحسن.
# العزاوي 4/ 237
# حسن (البو) :
# فرقة من اللهيب، عدد بيوتها 145، مراكزها الرئيسية: قرى مناطق جسر
~~الشغور، وجبل سمعان، ومناطق تجولها: جبل علص، وأسرية، والمضابع، وكديم،
~~وعين الكوم بسورية.
# (خ) مذكراتي.
# حسن (البو) :
# فخذ من البو طراز من العزة بالعراق. فروعه: البو جمعة، البو عيادة،
~~الطرازات، مجرن، البو فتيان، البو ظاهر، والبو طلاع. ms1096
# العزاوي 3/ 180- 181
### $ 
### $ حسن (بيت) :
# </span>
# فرع من الذهبيات من بني لام بالعراق.
# الطاهر 1/ 299
# حسن (بيت) :
# فرع من عشيرة الطرابشة بالعراق.
# الطاهر 1/ 98
### $ حسن الاحيمد (البو) :
# فخذ من البو ظاهر من المشاهدة بالعراق.
# العزاوي 4/ 237
### $ الحسن الجاسم:
# فخذ من البو جبر من البو حسين النجاد من البو نجاد. يقيم في الماحوز في
~~أنحاء كركوك قرب شبيكة بالعراق.
# العزاوي 3/ 83
# PageV04P109
### $ حسن الحسين (البو) :
# فرع من البو حسين الخالد من البو خالد من البو عزام من خلفة خميس
~~بالعراق.
# العزاوي 3/ 120
### $ حسن الحمد (البو) :
# فرع من بو شاووش من الحلابسة بالعراق.
# العزاوي 3/ 116
### $ حسن الخابور (البو) :
# من عشائر العقيدات بالعراق. تسكن في الرضوانية.
# العزاوي 3/ 134
### $ حسن السالم (البو) :
# فرع من البو زيدان من البو ذياب من خلفة خميس بالعراق.
# العزاوي 3/ 121
### $ حسن الطوي (البو) .
# فرع من البو طوي من البو الأجود من المزة بالعراق.
# العزاوي 3/ 170
### $ حسن الظاهر:
# فخذ من الظاهر من البو عز الدين من البو جمال (كمال) من العقيدات، مراكزه
~~الرئيسية: الحوايج ومناطق تجوله، منطقة الميادين بمحافظة دير الزور بسورية.
# (خ) مذكراتي.
### $ حسن العرار (البو) :
# فرع من البو عرار من البو علوان بالعراق.
# العزاوي 3/ 115- 116
### $ حسن علوان الحمد (آل) :
# فرع من البو عزبة من البو صكر (صقر) من الجنابيين بالعراق.
# العزاوي 3/ 99
### $ 
### $ حسن العلي (البو) :
# </span>
# فرع من الدلي من البو بكر من العزة بالعراق.
# العزاوي 3/ 175
# حسن العلي (البو) :
# فرع من البو شاجم من البو جواري من اليسار بالعراق.
# العزاوي 3/ 258
### $ حسن الفارس (البو) :
# فرع من البو فارس من البو أجود من العزة بالعراق.
# العزاوي 3/ 170
### $ حسن النمر (البو) :
# فخذ يعد في عداد البو محل النمر من البو نمر من البو سالم بالعراق.
# العزاوي 4/ 113
# PageV04P110
### $ حسنة (البو) :
# فرع من آل بلادي من آل كيم من الفتلة بالعراق.
# العزاوي 3/ 146
### $ حسنية (آل) :
# بطن من الجنابات بالعراق. يقيم في هور الشامية، منه: آل كاظم، آل سميح،
~~وآل منصور.
# العزاوي 3/ 104، 105
### $ الحسنيون:
# فصيلة من العلويين من الطالبيين من هاشم من قريش، وهم ms1097 بنو الحسن السيط بن
~~علي بن أبي طالب من فاطمة بنت محمد صلى الله عليه وسلم.
# ومن الحسنيين المذكورين من بويع له بالخلافة كالمهدي محمد بن عبد الله
~~الكامل، وإبراهيم بن عبد الله أخو المهدي المقدم ذكره ومنهم الأدارسة بنو
~~إدريس بالمغرب، ومنهم السليمانيون، ومنهم الهواشم بمكة، وبنو قتادة بمكة،
~~ومن بني حسن غير من تقدم في الشرق والغرب.
# القلائد 160- 163
### $ 
### $ 
### $ 
### $ 
### $ الحسون:
# </span></span></span></span>
# فرع من البو جمال (البو كمال) بالعراق. يسكن في الجزيرة والشامية منه:
~~البو حمودي، بو محمد، والعلي.
# العزاوي 3/ 130
# الحسون:
# فرع من الشويخ من الهيجل من الجبور بالعراق.
# العزاوي 3/ 83
# الحسون:
# فخذ من النواشي بالعراق.
# الطاهر 1/ 147
# الحسون:
# فرع من السفاح من آل رحمة بالعراق.
# الطاهر 1/ 150
# الحسون:
# فخذ من عشيرة أهالي الجلعة الملحقة ببني مالك بالعراق.
# العزاوي 4/ 68
### $ 
### $ 
### $ حسون (البو) :
# </span></span>
# فرع من المصالحة من الجنابيين بالعراق. يقيم في الشامية، (أبي صخير)
~~بالعراق. يقيم في 0 الشامية، (أبي صخير) وفي الاسكندرية وشيشبار واللطيفية.
~~وأصل هذا الفرع من البو مهلهل فاستقل فروعه: البو سوادي، الحبيب، البو
~~يجات، المهيدي، البراك، المصاليخ، والشيحان.
# العزاوي 3/ 102- 103
# حسون (البو) :
# فرع من آل بدر من الغزي، من بني لام بالعراق.
# العزاوي 3/ 232
# PageV04P111
### $ حسون (البو) :
# فخذ من الفتلة بالعراق. فروعه: البو حمد، البو عسكر، البو علكم (علقم) ،
~~البو علية، الحريزات، والبو خريف.
# العزاوي 3/ 148- 149
### $ حسون مرشدة:
# من عشائر محافظة دير الزور بسورية، مراكزها الرئيسية قرية السوسة.
# (خ) مذكراتي.
### $ حسوني (آل) :
# فرع من الهراوي من آل زياد بالعراق.
# العزاوي 4/ 131
### $ الحسية:
# فخذ من الرفيع بالعراق.
# فروعه: آل فضل، ومنه رؤساء العشيرة، آل تلعة، اللسبان، وآل علي.
# العزاوي 4/ 82
### $ حسير (بنو، بني) :
# فخذ من بني خالد بمنطقة حماه وسلمية بسورية، عدد بيوته 70 من فروعه:
~~العلي، الفارس، السلوم، هليفات، والغرب.
# (خ) مذكراتي.
